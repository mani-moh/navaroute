# ==============================================================================
# NavaRoute Environment Configuration Example (copy to '.env' for local runs)
# NEVER commit your actual '.env' file or secret tokens to Git!
# ==============================================================================

# NVIDIA NIM API key for the Autonomous Subscription Discovery Agent
# Obtain from: https://build.nvidia.com/
NVIDIA_API_KEY=<your-nvidia-api-key>

# Optional: override the default AI search/discovery NIM model
# Default: nvidia/nemotron-3-ultra-550b-a55b
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# ==============================================================================
# PattN Environment Configuration Example (copy to '.env' for local runs)
# NEVER commit your actual '.env' file or secret tokens to Git!
# ==============================================================================

# NVIDIA NIM API key for the Autonomous Subscription Discovery Agent
# Obtain from: https://build.nvidia.com/
NVIDIA_API_KEY=<your-nvidia-api-key>

# Optional: override the default frontier NIM model
# Default: moonshotai/kimi-k2.6
# NVIDIA_MODEL=moonshotai/kimi-k2.6

# Optional: private BPB subscription links (also supported via sources.private.json)
# PRIVATE_SOURCES=https://your-worker.pages.dev/uuid/sub/normal

# Optional: GitHub Secret Gist credentials for syncing private_subs/
# GIST_TOKEN=<your-github-gist-pat>
# GIST_ID=your_secret_gist_id_here
